#!/usr/bin/env sh
# Reference CLI for the Behavior Parallel Tree (BPT).
# This is development tooling, NOT the app stack. It can be swapped out.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-help}"

case "$cmd" in
  validate)
    shift
    exec python3 "$HERE/tools/bpt/validate.py" "$@"
    ;;
  check)
    shift
    exec python3 "$HERE/tools/bpt/check.py" "$@"
    ;;
  help|--help|-h|"")
    echo "bpt: reference tool for the Behavior Parallel Tree"
    echo ""
    echo "usage: ./bpt <command>"
    echo ""
    echo "commands:"
    echo "  validate   validate bpt.config.yaml and the tree (7 invariants)"
    echo "  check      everything BPT checks about itself: validate, the"
    echo "             refusal cases, and the docs against the tree"
    echo "  help       show this help"
    echo ""
    echo "to materialize a new behavior, use the adapter (scaffold):"
    echo "  echo '{\"node\":{\"id\":\"product.create\",\"sides\":[\"backend\",\"frontend\"]}}' \\"
    echo "    | adapters/placeholder/bin/bpt-adapter scaffold"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "run ./bpt help" >&2
    exit 2
    ;;
esac
