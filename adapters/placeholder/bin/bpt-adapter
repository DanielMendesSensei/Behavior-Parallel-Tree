#!/usr/bin/env python3
"""BPT placeholder adapter: dispatcher.

Neutral protocol (every adapter honors it):
    bpt-adapter <hook> < request.json > response.json
stdin  = 1 JSON object
stdout = 1 JSON object
stderr = logs
exit 0 = the adapter ran (success/failure is reported in the "status" field)
exit != 0 = the adapter itself broke

This placeholder knows no stack. Only the 'scaffold' hook does real work. A real
adapter (e.g. web-ts, python-fastapi) replaces the scripts in hooks/ with its own
stack logic, while keeping this same protocol.
"""
import os
import subprocess
import sys

HOOKS = ["scaffold", "plan", "execute", "verify", "review", "codegen"]


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in HOOKS:
        sys.stderr.write("usage: bpt-adapter <%s>\n" % "|".join(HOOKS))
        return 2
    hook = sys.argv[1]
    here = os.path.dirname(os.path.abspath(__file__))
    script = os.path.join(here, "..", "hooks", hook + ".py")
    # stdin/stdout/stderr are inherited: the hook talks directly to the caller.
    return subprocess.call([sys.executable, script])


if __name__ == "__main__":
    raise SystemExit(main())
