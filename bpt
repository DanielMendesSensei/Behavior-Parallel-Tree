#!/usr/bin/env sh
# CLI de referencia do Behavior Parallel Tree (BPT).
# Isto e tooling de desenvolvimento, NAO a stack do app. Pode ser trocado.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-help}"

case "$cmd" in
  validate)
    shift
    exec python3 "$HERE/tools/bpt/validate.py" "$@"
    ;;
  help|--help|-h|"")
    echo "bpt: ferramenta de referencia do Behavior Parallel Tree"
    echo ""
    echo "uso: ./bpt <comando>"
    echo ""
    echo "comandos:"
    echo "  validate   valida bpt.config.yaml e a arvore (7 invariantes)"
    echo "  help       mostra esta ajuda"
    echo ""
    echo "para materializar um comportamento novo, use o adapter (scaffold):"
    echo "  echo '{\"node\":{\"id\":\"produto.criar\",\"sides\":[\"backend\",\"frontend\"]}}' \\"
    echo "    | adapters/placeholder/bin/bpt-adapter scaffold"
    ;;
  *)
    echo "comando desconhecido: $cmd" >&2
    echo "rode ./bpt help" >&2
    exit 2
    ;;
esac
